    {
      "id": "text-59",
      "type": "text",
      "x": 60,
      "y": 750,
      "width": 1246.6,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 961384312,
      "version": 1,
      "versionNonce": 2133288763,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763000000000,
      "link": null,
      "locked": false,
      "text": "Vendas: o PDV só considera o evento entregue quando o RabbitMQ confirma (publisher confirms). Sem confirmação, o SaleFiscalOutboxJob tenta de novo a cada 30 s.",
      "originalText": "Vendas: o PDV só considera o evento entregue quando o RabbitMQ confirma (publisher confirms). Sem confirmação, o SaleFiscalOutboxJob tenta de novo a cada 30 s.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 13.3
    },
    {
      "id": "text-60",
      "type": "text",
      "x": 60,
      "y": 780,
      "width": 909.4,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 176544135,
      "version": 1,
      "versionNonce": 1370813618,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763000000000,
      "link": null,
      "locked": false,
      "text": "Fiscal: índice único por venda (tenantId + saleId) e por devolução, então mensagem repetida não gera nota duplicada.",
      "originalText": "Fiscal: índice único por venda (tenantId + saleId) e por devolução, então mensagem repetida não gera nota duplicada.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 13.3
    },
    {
      "id": "text-61",
      "type": "text",
      "x": 60,
      "y": 810,
      "width": 807.5,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1452261751,
      "version": 1,
      "versionNonce": 838268176,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763000000000,
      "link": null,
      "locked": false,
      "text": "Lentidão: cada rota publica no máximo um evento a cada 10 s; os demais vão somados no campo suppressed.",
      "originalText": "Lentidão: cada rota publica no máximo um evento a cada 10 s; os demais vão somados no campo suppressed.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 13.3
    }
